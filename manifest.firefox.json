{
  "manifest_version": 2,
  "name": "HN Comments Counter for The Old Reader",
  "version": "1.1",
  "description": "Shows comment counts and top comments for Hacker News links in The Old Reader",

  "browser_specific_settings": {
    "gecko": {
      "id": "hn-comments-counter@theoldreader",
      "strict_min_version": "57.0"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_scripts": [
    {
      "matches": ["*://theoldreader.com/*"],
      "js": ["browser-polyfill.js", "content.js"],
      "run_at": "document_end"
    }
  ],

  "permissions": [
    "activeTab",
    "storage",
    "tabs",
    "https://hacker-news.firebaseio.com/*",
    "https://theoldreader.com/*"
  ],

  "options_ui": {
    "page": "options.html",
    "browser_style": true
  }
}
