{
  "manifest_version": 3,
  "name": "HN Comments Counter for The Old Reader",
  "version": "1.3",
  "description": "Shows comment counts and top comments for Hacker News links in The Old Reader",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://theoldreader.com/*"],
      "js": ["browser-polyfill.js", "content.js"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://hacker-news.firebaseio.com/*",
    "https://theoldreader.com/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  }
}